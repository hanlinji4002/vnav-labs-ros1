
<launch>
  <!-- Launch desired trajectory (smooth_start:=true for a gentle take-off onto the circle) -->
  <arg name="smooth_start" default="false"/>
  <node name="traj_publisher" pkg="controller_pkg" type="traj_publisher">
    <param name="smooth_start" value="$(arg smooth_start)"/>
  </node>

  <!-- Launch our controller -->
  <node name="controller_node" pkg="controller_pkg" type="controller_node"/>

  <!-- Controller gains (tuned values as defaults; can be overridden, e.g. kr:=16) -->
  <arg name="kx" default="10"/>
  <arg name="kv" default="5"/>
  <arg name="kr" default="30"/>
  <arg name="komega" default="2.5"/>
  <param name="kx" type="double" value="$(arg kx)" />
  <param name="kv" type="double" value="$(arg kv)" />
  <param name="kr" type="double" value="$(arg kr)" />
  <param name="komega" type="double" value="$(arg komega)" />

</launch>
