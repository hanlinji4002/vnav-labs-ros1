
<launch>
  <!-- Launch desired trajectory (smooth_start:=true for a gentle take-off onto the circle) -->
  <arg name="smooth_start" default="false"/>
  <node name="traj_publisher" pkg="controller_pkg" type="traj_publisher">
    <param name="smooth_start" value="$(arg smooth_start)"/>
  </node>

  <!-- Launch our controller -->
  <node name="controller_node" pkg="controller_pkg" type="controller_node"/>

  <!-- Controller gains -->
  <param name="kx" type="double" value="10" />
  <param name="kv" type="double" value="5" />
  <param name="kr" type="double" value="30" />
  <param name="komega" type="double" value="2.5" />

</launch>
